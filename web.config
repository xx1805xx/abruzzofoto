<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' https://www.googletagmanager.com 'sha256-70RUvp/cTcUHSdZccH/5BL4RiZviXh9aPB7Wuxo933s=' 'sha256-TExL2oxBB7KPFnfd5cvPiyK7V9o+8DP1YWUoKMUADJE=' 'sha256-Wai89fQ9xVBl3HEcI5kUfAyKC3qSUSXjGKcd6qbEpeg=' 'sha256-a7aopp4j4+uyUqS5BKDOVvjRCrZnzMMJE4uEF+kaYSU=' 'sha256-cjeVKbW8aqY8xknF8kUlKvzsv1KD9y4JWJSq+q72KkA=' 'sha256-nLwGZ27RTVN7IkdBfOxvN8K2dxgB3vzHJb/vIx8vT88=' 'sha256-nLzI6G2cnKiM55sIuVvy5L61DdzwqVRnam4dcrtLd1M=' 'sha256-u+kBUaDWxccfbMNUVR/cG4czyu+w21mGjVlqqWszQrg=' 'sha256-uxujKPGcNWGkUOmm94s67Mm98+DmnGo5hgD4VrmwUzo='; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; frame-ancestors 'none'; form-action https://formsubmit.co; upgrade-insecure-requests" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="AbruzzoFotoLegacy0" stopProcessing="true">
          <match url="^_/Home\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy1" stopProcessing="true">
          <match url="^_/Matrimoni\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/matrimoni.html" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy2" stopProcessing="true">
          <match url="^_/Book\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/ritratti.html" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy3" stopProcessing="true">
          <match url="^_/Saggi_di_Danza\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/danza-sport.html" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy4" stopProcessing="true">
          <match url="^_/Sport\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/danza-sport.html" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy5" stopProcessing="true">
          <match url="^_/Macro\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/macro.html" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy6" stopProcessing="true">
          <match url="^_/Servizi\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/#servizi" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="AbruzzoFotoLegacy7" stopProcessing="true">
          <match url="^_/Contattami\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.abruzzofoto.it/#contatti" redirectType="Permanent" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>